---
import { url, unbase } from '../lib/url';
import '../styles/global.css';
import fontUrl from '@fontsource-variable/raleway/files/raleway-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBar from '../components/ContactBar.astro';
import { site, priceRange, facilities } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Path to a social sharing image in /public. */
  ogImage?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, ogImage = '/og-image.jpg', schema = [] } = Astro.props;
const canonical = new URL(unbase(Astro.url.pathname), site.url).href;
const fullTitle = title === site.name ? `${site.name} | Accommodation in Jane Furse` : `${title} | ${site.name}`;

const lodging = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': `${site.url}/#lodge`,
  name: site.name,
  url: site.url,
  description: site.description,
  image: new URL(ogImage, site.url).href,
  telephone: site.phones[0].tel,
  email: site.email,
  priceRange,
  currenciesAccepted: 'ZAR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.town,
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  amenityFeature: facilities.map((f) => ({
    '@type': 'LocationFeatureSpecification',
    name: f.name,
    value: true,
  })),
  sameAs: [site.facebook],
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('/favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#1f1b14" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([lodging, ...schema])} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ContactBar />
  </body>
</html>
