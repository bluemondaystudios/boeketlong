---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo.png';
import { site, whatsappLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <Image src={logo} alt={site.name} width={180} densities={[1, 2]} format="webp" class="logo" />
      <address>
        <a href={site.mapsUrl} rel="noopener" target="_blank">
          <Icon name="pin" />
          <span>{site.address.street}<br />{site.address.town}, {site.address.postalCode}<br />Limpopo</span>
        </a>
      </address>
    </div>

    <div>
      <h2>Get in touch</h2>
      <ul>
        {
          site.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`}>
                <Icon name="phone" />
                <span>
                  {p.display} <small>{p.label}</small>
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={whatsappLink()} rel="noopener"><Icon name="whatsapp" /> <span>WhatsApp us</span></a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}><Icon name="mail" /> <span>{site.email}</span></a>
        </li>
        <li>
          <a href={site.facebook} rel="noopener" target="_blank"><Icon name="facebook" /> <span>Facebook</span></a>
        </li>
      </ul>
    </div>

    <div>
      <h2>Explore</h2>
      <ul class="links">
        <li><a href={url('/accommodation/')}>Accommodation</a></li>
        <li><a href={url('/facilities/')}>Facilities</a></li>
        <li><a href={url('/facilities/conference-centre/')}>Conferences & functions</a></li>
        <li><a href={url('/gallery/')}>Gallery</a></li>
        <li><a href={url('/about/')}>About us</a></li>
        <li><a href={url('/contact/')}>Contact & directions</a></li>
      </ul>
    </div>
  </div>

  <div class="container legal">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p><a href={url('/privacy/')}>Privacy policy</a> · <a href={url('/terms/')}>Terms</a></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgb(255 255 255 / 0.75);
    padding-top: 64px;
    font-size: 0.97rem;
  }
  .cols {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 760px) {
    .cols {
      grid-template-columns: 1.2fr 1.4fr 1fr;
    }
  }
  .cols :global(.logo) {
    display: block;
    width: 180px;
    height: auto;
    margin-bottom: 1.5rem;
  }
  h2 {
    color: var(--white);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  address {
    font-style: normal;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    gap: 10px;
    align-items: flex-start;
  }
  a:hover {
    color: var(--gold);
  }
  a :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--gold);
  }
  small {
    opacity: 0.6;
    margin-left: 4px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-block: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.85rem;
  }
  .legal p {
    margin: 0;
  }
  .legal a {
    display: inline;
    text-decoration: underline;
  }
</style>
