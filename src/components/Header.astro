---
import { url, unbase } from '../lib/url';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import crest from '../assets/brand/crest.png';
import stars from '../assets/brand/stars.png';
import { site } from '../data/site';

const links = [
  { href: '/accommodation/', label: 'Accommodation' },
  { href: '/facilities/', label: 'Facilities' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const path = unbase(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class:list={['site-header', { overlay }]}>
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label={`${site.name} home`}>
      <Image src={crest} alt="" height={40} densities={[1, 2]} format="webp" loading="eager" class="crest" />
      <span class="wordmark">
        <span class="name"><span class="brand-name">Boeketlong</span> <span class="brand-sub">Lodge</span></span>
        <Image src={stars} alt="" height={14} densities={[1, 2]} format="webp" loading="eager" class="stars" />
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {
        links.map((l) => (
          <a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="btn btn-primary" href={url('/contact/#enquire')}>Book now</a>
      <ThemeToggle />
    </nav>

    <div class="mobile-actions">
      <ThemeToggle />
    <details class="nav-mobile">
      <summary aria-label="Menu">
        <span class="open"><Icon name="menu" size={26} /></span>
        <span class="shut"><Icon name="close" size={26} /></span>
      </summary>
      <nav aria-label="Main">
        <a href={url('/')}>Home</a>
        {
          links.map((l) => (
            <a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
        <a class="btn btn-primary" href={url('/contact/#enquire')}>Book now</a>
      </nav>
    </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--night) 96%, transparent);
    color: var(--white);
    backdrop-filter: blur(8px);
    view-transition-name: site-header;
    transition:
      background-color 0.35s,
      backdrop-filter 0.35s,
      box-shadow 0.35s;
  }
  .site-header.scrolled {
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
  }
  /* Transparent over the hero until the visitor scrolls (needs JS to un-set). */
  :global(.js) .overlay:not(.scrolled):not(:has(details[open])) {
    background: linear-gradient(180deg, rgb(20 17 12 / 0.8), rgb(20 17 12 / 0.35) 70%, transparent);
    backdrop-filter: none;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--white);
    text-decoration: none;
  }
  .brand :global(.crest) {
    width: auto;
    height: 40px;
  }
  .wordmark {
    display: grid;
    gap: 3px;
    justify-items: start;
  }
  .name {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    line-height: 1.1;
  }
  .brand :global(.stars) {
    width: auto;
    height: 14px;
  }
  .brand-name {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand-sub {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 28px;
  }
  .nav-desktop a:not(.btn),
  .nav-mobile nav a:not(.btn) {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
    font-weight: 600;
  }
  .nav-desktop a:not(.btn) {
    position: relative;
    padding-block: 6px;
  }
  .nav-desktop a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }
  .nav-desktop a:not(.btn):hover::after,
  .nav-desktop a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-desktop a:not(.btn):hover,
  [aria-current='page'] {
    color: var(--white) !important;
  }
  .nav-mobile [aria-current='page'] {
    color: var(--gold) !important;
  }
  .nav-desktop .btn {
    min-height: 42px;
    padding-block: 0.45em;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -10px;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav-mobile .shut,
  .nav-mobile[open] .open {
    display: none;
  }
  .nav-mobile[open] .shut {
    display: block;
  }
  .nav-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px var(--gutter) 24px;
    background: var(--night);
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .nav-mobile nav a:not(.btn) {
    padding: 12px 0;
    font-size: 1.1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .nav-mobile nav .btn {
    margin-top: 16px;
  }

  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  @media (min-width: 900px) {
    .nav-desktop {
      display: flex;
    }
    .mobile-actions {
      display: none;
    }
  }
</style>
