---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<Base title="Privacy Policy" description={`How ${site.name} handles your personal information.`}>
  <PageHero title="Privacy policy" />
  <section class="section">
    <div class="container prose">
      <!-- TODO(lodge): have this reviewed and name the Information Officer required by POPIA. -->
      <p>
        {site.name} respects your privacy and processes personal information in line with the Protection of
        Personal Information Act (POPIA).
      </p>
      <h2>What we collect</h2>
      <p>
        When you send a booking enquiry, call, WhatsApp or email us, we receive the details you give us, such as
        your name, phone number, email address, travel dates and any notes.
      </p>
      <h2>How we use it</h2>
      <p>
        We use your details only to answer your enquiry, manage your booking and stay, and meet our legal
        obligations. We do not sell your information or use it for marketing without your consent.
      </p>
      <h2>This website</h2>
      <p>
        This website does not use advertising or tracking cookies. The booking form does not store anything on our
        servers: it simply prepares a WhatsApp message or email that you choose to send.
      </p>
      <h2>Your rights</h2>
      <p>
        You may ask us what information we hold about you, and ask us to correct or delete it, by emailing
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</Base>
