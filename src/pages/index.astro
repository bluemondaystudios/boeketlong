---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import RoomCard from '../components/RoomCard.astro';
import FacilityGrid from '../components/FacilityGrid.astro';
import Icon from '../components/Icon.astro';
import { site, rooms, whatsappLink, formatRand } from '../data/site';

const cheapest = Math.min(...rooms.map((r) => r.from));
---

<Base title={site.name}>
  <section class="hero">
    <Photo name="hero" alt="The reception lounge at Boeketlong Lodge" sizes="100vw" widths={[640, 960, 1440, 1920]} priority aspect="auto" class="hero-img" />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <span class="eyebrow">Jane Furse · Sekhukhune · Limpopo</span>
      <h1>Make yourself at home</h1>
      <p class="lead">
        Elegant rooms, a pool, spa, gym, bar and conference centre, in the heart of Makhuduthamaga.
        Rooms from {formatRand(cheapest)} a night.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/contact/#enquire')}>Check availability <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href={url('/accommodation/')}>View rooms & rates</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Welcome</span>
        <h2>A warm welcome in the heart of Sekhukhune</h2>
        <p>
          Boeketlong Lodge sits at the centre of Makhuduthamaga, an easy base for business, family visits and
          exploring the area around Jane Furse. Feel the warm northern sun and wide blue skies, then relax in
          an elegant, contemporary room.
        </p>
        <p>
          We opened in {site.history.opened} as {site.history.previousName} and became Boeketlong Lodge
          in {site.history.convertedToLodge}. We still welcome every guest personally.
        </p>
        <a href={url('/about/')}>More about us</a>
      </div>
      <Photo name="welcome" alt="Inside Boeketlong Lodge" sizes="(min-width: 900px) 560px, 100vw" class="rounded" aspect="4 / 3" />
    </div>
  </section>

  <section class="section section-sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Accommodation</span>
        <h2>Rooms and suites for every stay</h2>
        <p class="lead">Every room sleeps two, or four in the Family Suite. Breakfast can be added to any room.</p>
      </div>
      <div class="grid grid-3">
        {rooms.map((room) => <RoomCard room={room} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Facilities</span>
        <h2>Everything you need, on site</h2>
      </div>
      <FacilityGrid />
    </div>
  </section>

  <section class="section band">
    <div class="container band-inner">
      <div>
        <span class="eyebrow">Conferences & functions</span>
        <h2>Planning a meeting, wedding or party?</h2>
        <p>Host it at our conference centre, with accommodation, catering and the bar all in one place.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/facilities/conference-centre/')}>Conference centre</a>
        <a class="btn btn-ghost" href={whatsappLink('Hi Boeketlong Lodge, I would like a quote for a function.')} rel="noopener">
          Ask for a quote
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Find us</span>
        <h2>{site.address.street}, {site.address.town}</h2>
        <p>Call, WhatsApp or email and we'll help with bookings, directions and anything else you need.</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={18} /> Get directions</a>
          <a class="btn btn-whatsapp" href={whatsappLink()} rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
          <a class="btn btn-ghost" href={`tel:${site.phones[0].tel}`}><Icon name="phone" size={18} /> {site.phones[0].display}</a>
        </div>
      </div>
      <Photo name="exterior" alt="The lodge from outside" sizes="(min-width: 900px) 560px, 100vw" class="rounded" aspect="4 / 3" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(88svh, 820px);
    color: var(--white);
    background: var(--ink);
    overflow: hidden;
  }
  .hero > :global(*) {
    grid-area: 1 / 1;
  }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    background:
      linear-gradient(0deg, rgb(20 17 12 / 0.9), rgb(20 17 12 / 0.7) 55%, rgb(20 17 12 / 0.2) 85%),
      linear-gradient(90deg, rgb(20 17 12 / 0.55), transparent 70%);
  }
  .hero-content {
    position: relative;
    align-self: end;
    padding-block: 120px clamp(48px, 9vw, 96px);
  }
  .hero .eyebrow {
    color: #e3c55a;
  }
  .hero-content {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }
  .hero h1 {
    max-width: 12ch;
    font-size: clamp(2.6rem, 8vw, 5rem);
  }
  .hero .lead {
    color: rgb(255 255 255 / 0.85);
    margin-bottom: 1.6rem;
  }

  .split {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
  .split :global(.rounded) {
    border-radius: var(--radius);
  }
  .split .btn-row {
    margin-top: 1.2rem;
  }
  .split .btn-ghost {
    color: var(--ink);
  }

  .band {
    background: var(--ink);
    color: rgb(255 255 255 / 0.85);
  }
  .band h2 {
    color: var(--white);
  }
  .band .eyebrow {
    color: var(--gold);
  }
  .band-inner {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .band-inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .band .btn-row {
      justify-content: flex-end;
    }
  }
</style>
