---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Every image dropped into src/assets/gallery/ appears here, sorted by filename.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const alt = path
        .replace(/^.*\/|\.[^.]+$/g, '')
        .replace(/^\d+[-_ ]*/, '')
        .replace(/[-_]+/g, ' ');
      const full = await getImage({ src: mod.default, width: 1800, format: 'webp', quality: 78 });
      return { src: mod.default, alt: alt || 'Boeketlong Lodge', full: full.src };
    }),
);
---

<Base title="Gallery" description="Photos of the rooms, pool, bar and facilities at Boeketlong Lodge in Jane Furse.">
  <PageHero eyebrow="Gallery" title="Take a look around" />
  <section class="section">
    <div class="container">
      {
        photos.length ? (
          <ul class="masonry">
            {photos.map((p) => (
              <li>
                <a href={p.full}>
                  <Image src={p.src} alt={p.alt} widths={[400, 700]} sizes="(min-width: 960px) 360px, (min-width: 600px) 50vw, 100vw" format="webp" quality={70} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">Photos coming soon. In the meantime, see more on our Facebook page.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 14px;
  }
  @media (min-width: 600px) {
    .masonry {
      columns: 2;
    }
  }
  @media (min-width: 960px) {
    .masonry {
      columns: 3;
    }
  }
  li {
    break-inside: avoid;
    margin-bottom: 14px;
  }
  a {
    display: block;
    border-radius: 10px;
    overflow: hidden;
  }
  a :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s;
  }
  a:hover :global(img) {
    transform: scale(1.03);
  }
  .empty {
    color: var(--ink-soft);
  }
</style>
